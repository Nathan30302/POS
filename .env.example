# --- Core ---
NODE_ENV=development
PORT=4000
WEB_PORT=5173
# Required in production (≥32 chars, not a placeholder)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# SQLite (default local/demo)
DATABASE_URL=file:./prisma/dev.db

# PostgreSQL (after: npm run db:use-postgres && docker compose up -d db)
# DATABASE_URL=postgresql://nexora:nexora_dev_change_me@127.0.0.1:5432/nexora
# POSTGRES_PASSWORD=nexora_dev_change_me
# POSTGRES_PORT=5432

# Required in production (comma-separated browser origins)
# CORS_ORIGIN=https://your-shop.example.com,http://localhost:5173

# Public HTTPS shop URL for phone QR / Prefer over LAN
# SHOP_PUBLIC_ORIGIN=https://your-tunnel.example.com

# Required in production — MoMo / payment webhook shared secret
# MOMO_WEBHOOK_SECRET=generate-a-long-random-secret

# Optional — shared rate limits across API instances (falls back to memory)
# REDIS_URL=redis://127.0.0.1:6379

# Optional MoMo Collection (sandbox/agent fallback unless keys set)
# MOMO_USE_SANDBOX=1
# MOMO_SUBSCRIPTION_KEY=
# MOMO_API_USER=
# MOMO_API_KEY=

# Backup directory for scripts/backup-db.sh
# NEXORA_BACKUP_DIR=./backups
